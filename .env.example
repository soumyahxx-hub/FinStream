# Copy to .env, set local secrets, and keep .env out of Git.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
POSTGRES_DB=finstream
POSTGRES_USER=finstream_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finstream_app:replace-with-a-long-local-password@postgres:5432/finstream
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_REPLAY_GROUP_ID=finstream-replay-v1
SPARK_MASTER=local[1]
SPARK_CHECKPOINT_ROOT=/opt/finstream/checkpoints
LAKE_URI=file:///opt/finstream/data/lake
AWS_REGION=ap-south-1
S3_LAKE_BUCKET=
AWS_AUTH_MODE=profile
AWS_PROFILE=finstream-dev
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-before-first-use
GRAFANA_ADMIN_PASSWORD=replace-before-first-use
PROMETHEUS_RETENTION=7d
SCHEMA_REGISTRY_EXTERNAL_URL=http://localhost:8081
KAFKA_VALIDATION_GROUP_ID=finstream-validation-v1
KAFKA_FRAUD_GROUP_ID=finstream-fraud-detection-v1
FRAUD_HIGH_VALUE_THRESHOLD=100000.00
FRAUD_BALANCE_TOLERANCE=1.00
FRAUD_MAX_PROCESSING_ATTEMPTS=3
